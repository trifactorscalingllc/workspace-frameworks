# Copy to .env and fill in. .env is gitignored.

# --- Model -------------------------------------------------------------------
# Directive runs read the model from here. Never pass --model on the CLI.
ANTHROPIC_MODEL=claude-opus-5

# Wall-clock ceiling for one directive run, seconds.
RUN_TIMEOUT=900

# --- Auth (read CLAUDE.md before touching this) -------------------------------
# Runs must bill the claude.ai subscription, which happens automatically when
# ANTHROPIC_API_KEY is ABSENT from the environment. Do NOT add it under its real
# name. If a key must exist on disk for the deliberate billed-API path, park it
# renamed — config.py and build_child_env() both refuse the real name:
#
# ANTHROPIC_API_KEY_DISABLED=sk-ant-...

# The deliberate opt-in for a host with no Keychain. Defaults OFF; leave it off
# on this Mac. run_directive.py refuses a billed run unless this is exactly "1"
# AND the caller asks for it explicitly — two locks, both opened on purpose.
ALLOW_BILLED_API=0

# --- Webhooks ----------------------------------------------------------------
# Required. Unset means every POST returns 401 (fail closed).
WEBHOOK_TOKEN=
WEBHOOK_PORT=8787

# --- Notifications -----------------------------------------------------------
# Slack incoming webhook. Unset = notifications are silently skipped.
SLACK_WEBHOOK_URL=

# --- Tool defaults -----------------------------------------------------------
EMAIL_FROM=
EMAIL_TO=
DIGEST_SHEET_ID=

# --- Instagram Graph API (content_review) -------------------------------------
# Optional. Only the ig_posts tool needs these; everything else works without.
# Run: python execution/setup_meta_auth.py --check   for the console steps.
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_TOKEN_EXPIRES=
IG_USER_ID=

# --- Content plan sheets ------------------------------------------------------
CONTENT_WEEK_SHEET_ID=
CONTENT_TRACKER_SHEET_ID=

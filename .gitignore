node_modules/
.env
# Timestamped copies bootstrap/edits leave behind. `.env` above does NOT match
# these, and they hold a live WEBHOOK_TOKEN — an unignored one would publish a
# secret the first time this template is pushed to a remote.
.env.bak*
__pycache__/
.venv/

# Google OAuth — required files, never committed
credentials.json
token.json

# Intermediates: always regenerated, never committed.
# config.py recreates the directory on import, so nothing is tracked here.
.tmp/

.DS_Store
*.pyc

# Armed by bootstrap.py, consumed on this workspace's first open. Per-copy
# state, so it must never be committed or every clone would inherit it spent.
.vscode/.open-claude-on-first-launch

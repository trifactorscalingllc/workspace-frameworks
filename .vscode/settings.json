{
  // A new workspace should open ready to work: Explorer on the left (VS Code's
  // default for a fresh folder) and a clear editor area — no Welcome tab
  // occupying the middle where the Claude session goes.
  "workbench.startupEditor": "none",

  // Skip the onboarding checklist; this workspace is already configured.
  "claudeCode.hideOnboarding": true,

  // Open Claude as a tab in the middle automatically — but only on the FIRST
  // launch of a new workspace. `claude-vscode.editor.open` calls createPanel(),
  // so it always makes a new tab; and VS Code restores the Claude webview on
  // later opens (the extension declares onWebviewPanel:claudeVSCodePanel). An
  // unconditional rule would therefore stack a second, empty tab every time.
  //
  // bootstrap.py drops the marker file; the second rule clears it, so this
  // fires once and then gets out of the way. If the marker is ever left behind,
  // the worst case is the old behaviour of opening a tab each launch.
  // One rule, two commands in order: close whatever VS Code opened on startup
  // (the Welcome tab — workbench.startupEditor is application-scoped, so a
  // workspace setting cannot suppress it), then open Claude in the middle.
  // closeAllEditors is safe here only because this fires on first launch, when
  // nothing of yours is open yet.
  //
  // The cleanup path is absolute because the extension runs shell commands with
  // exec() and no cwd, so a relative path resolves somewhere else entirely.
  // bootstrap.py rewrites __MARKER_PATH__ with this workspace's real path.
  "auto-run-command.rules": [
    {
      "condition": "hasFile: .vscode/.open-claude-on-first-launch",
      "command": [
        "workbench.action.closeAllEditors",
        "claude-vscode.editor.open"
      ],
      "message": "Priming workspace: opening Claude Code"
    },
    {
      "condition": "hasFile: .vscode/.open-claude-on-first-launch",
      "command": "rm -f __MARKER_PATH__",
      "shellCommand": true,
      "message": "Clearing the first-launch marker"
    }
  ],

  // The venv is thousands of files. Keep it visible in the Explorer, but out of
  // search results and the file watcher, which otherwise get slow and noisy.
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.tmp": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true
  },
  "files.exclude": {
    "**/__pycache__": true
  },

  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
}
